   "source": [
    "from math import gcd\n",
    "\n",
    "pembilang = 8\n",
    "penyebut = 12\n",
    "\n",
    "fpb = gcd(pembilang, penyebut)\n",
    "\n",
    "print(\"FPB:\", fpb)\n",
    "\n",
    "pembilang = pembilang // fpb\n",
    "penyebut = penyebut // fpb\n",
    "\n",
    "print(\"Hasil:\", pembilang, \"/\", penyebut)"
   ]
  }
 ],
